# ─────────────────────────────────────────────────────────────────────────────
#  AG2 optional settings
#
#  To use: copy this file to ".env" (same folder as docker-compose.yml),
#  change what you need, then run:  docker compose up -d
#  Every line is optional — delete or leave any you don't need.
# ─────────────────────────────────────────────────────────────────────────────

# Port for the dashboard. Change it if 3000 is already used on this computer.
# The dashboard will then be at http://<this-computer's-IP>:<port>
AG2_PORT=3000

# Database password. The database is never exposed to your network, so the
# built-in default is fine for home use. If you want your own, set it BEFORE
# the first start — changing it later requires resetting the database.
# DB_PASSWORD=pick-a-long-random-password

# Image version to run. "latest" gets updates with `docker compose pull`;
# pin a number (e.g. 2.0.0) to stay on one version.
AG2_VERSION=latest

# Optional API key. Only needed if other programs/scripts will call AG2's API.
# The dashboard itself never needs it. Leave empty to turn it off.
AG2_API_KEY=
