# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL / TimescaleDB password — generate with: openssl rand -hex 32
DB_PASSWORD=change-me

# ── Optional ────────────────────────────────────────────────────────────────
# Host port for the dashboard (default 3000). Use a different port if WeathAir
# is running on the same machine.
AG2_PORT=3000

# Require X-API-Key for API calls that don't come from the dashboard itself.
# Generate with: openssl rand -hex 32   (leave empty to disable)
AG2_API_KEY=

# Docker image to run / build (used by `make deploy`)
AG2_IMAGE=prezmcmahon/ag2:latest

# ── Local development only (npm run dev) ────────────────────────────────────
# DATABASE_URL=postgresql://ag2:change-me@localhost:5432/ag2
# DATA_DIR=./data
# Allow 127.0.0.1 device addresses so you can test with `npm run mock-device`.
# ALLOW_LOOPBACK_DEVICES=true
