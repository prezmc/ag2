# ─────────────────────────────────────────────────────────────────────────────
#  AG2 optional settings
#
#  You don't need this file. AG2 works without it.
#  To change a setting: copy this file to ".env" (same folder), edit it, then
#  run:  docker compose up -d
# ─────────────────────────────────────────────────────────────────────────────

# Port for the dashboard. Change it if 3000 is already used on this computer.
# The dashboard will then be at http://<this-computer's-IP>:<port>
AG2_PORT=3000

# Optional API key. Only needed if other programs or scripts will call AG2's
# API. The dashboard itself never needs it. Leave empty to turn it off.
AG2_API_KEY=

# The database password is created automatically on first start and kept
# inside Docker — there's nothing to set here. (DB_PASSWORD is only for moving
# an install from an older version; see INSTALL.md.)
